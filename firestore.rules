rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Lead Admin or Owner verification helper
    function isLeadAdmin() {
      return isSignedIn() &&
        (request.auth.token.role == 'admin' ||
         request.auth.token.email == 'valibotlavali@gmail.com');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isUser(userId) || isLeadAdmin();
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if true; // Public listings accessible to prospective tenants
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid || isLeadAdmin()
      );

      // Bookings subcollection
      match /bookings/{bookingId} {
        allow read: if isSignedIn();
        allow create: if true; // Prospective residents submitting booking
        allow update, delete: if isSignedIn();
      }

      // Payments subcollection
      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        allow read, write: if isSignedIn();
      }

      // Maintenance requests subcollection
      match /maintenance/{requestId} {
        allow read: if true;
        allow create: if true; // Residents can log maintenance issue
        allow update, delete: if isSignedIn(); // Owner/staff update status
      }
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
